+bool server_prompt_cache::write_disk_blob(
+        const std::string & path,
+        const uint8_t * tgt, size_t tgt_size,
+        const uint8_t * dft, size_t dft_size) {
+    FILE * f = std::fopen(path.c_str(), "wb");
+    if (!f) {
+        return false;
+    }
+    const char magic[4] = {'P', 'C', 'K', '1'};
+    const uint64_t hdr[2] = {uint64_t(tgt_size), uint64_t(dft_size)};
+    bool ok = std::fwrite(magic, 1, sizeof(magic), f) == sizeof(magic)
+           && std::fwrite(hdr, 1, sizeof(hdr), f) == sizeof(hdr)
+           && (tgt_size == 0 || std::fwrite(tgt, 1, tgt_size, f) == tgt_size)
+           && (dft_size == 0 || std::fwrite(dft, 1, dft_size, f) == dft_size);
+    if (std::fclose(f) != 0) {
+        ok = false;
+    }
+    if (!ok) {
+        std::remove(path.c_str());
+    }
+    return ok;
+}
+
+bool server_prompt_cache::read_disk_blob(
+        const std::string & path, size_t tgt_size, size_t dft_size,
+        std::vector<uint8_t> & tgt_out, std::vector<uint8_t> & dft_out) {
+    FILE * f = std::fopen(path.c_str(), "rb");
+    if (!f) {
+        return false;
+    }
+    char magic[4] = {};
+    uint64_t hdr[2] = {};
+    bool ok = std::fread(magic, 1, sizeof(magic), f) == sizeof(magic)
+           && std::memcmp(magic, "PCK1", 4) == 0
+           && std::fread(hdr, 1, sizeof(hdr), f) == sizeof(hdr)
+           && hdr[0] == uint64_t(tgt_size)
+           && hdr[1] == uint64_t(dft_size);
+    if (ok) {
+        try {
+            tgt_out.resize(tgt_size);
+            if (tgt_size > 0 && std::fread(tgt_out.data(), 1, tgt_size, f) != tgt_size) {
+                ok = false;
+            }
+            if (ok && dft_size > 0) {
+                dft_out.resize(dft_size);
+                if (std::fread(dft_out.data(), 1, dft_size, f) != dft_size) {
+                    ok = false;
+                }
+            }
+        } catch (const std::bad_alloc & e) {
+            SRV_WRN("failed to allocate transient buffer reading disk cache %s: %s\n", path.c_str(), e.what());
+            ok = false;
+        }
+    }
+    std::fclose(f);
+    if (!ok) {
+        tgt_out.clear();
+        tgt_out.shrink_to_fit();
+        dft_out.clear();
+        dft_out.shrink_to_fit();
+    }
+    return ok;
+}
+
+void server_prompt_cache::evict_disk_for(size_t incoming_bytes) {
+    if (disk_disabled || limit_disk_size == 0) {
+        return;
+    }
+    while (disk_size() + incoming_bytes > limit_disk_size) {
+        auto it = std::find_if(states.begin(), states.end(), [](const server_prompt_cache_state & s) {
+            return s.on_disk();
+        });
+        if (it == states.end()) {
+            break;
+        }
+        SRV_WRN(" - disk cache limit reached, removing oldest disk entry (size = %.3f MiB)\n",
+                it->disk_size() / (1024.0 * 1024.0));
+        remove_disk_file(*it);
+        states.erase(it);
+    }
+}
+
+bool server_prompt_cache::spill_state_to_disk(server_prompt_cache_state & state) {
+    if (disk_disabled || state.on_disk()) {
+        return false;
+    }
+    const size_t total = state.data.size();
+    if (limit_disk_size > 0 && total > limit_disk_size) {
+        return false;
+    }
+    evict_disk_for(total);
+    const std::string path = (std::filesystem::path(disk_dir) / ("ps5lm_ckpt_" + std::to_string(next_disk_id++) + ".bin")).string();
+    if (!write_disk_blob(path, state.data.main.data(), state.data.main.size(), state.data.drft.data(), state.data.drft.size())) {
+        return false;
+    }
+    state.disk_path = path;
+    state.disk_size_tgt = state.data.main.size();
+    state.disk_size_dft = state.data.drft.size();
+    state.data.main.clear();
+    state.data.main.shrink_to_fit();
+    state.data.drft.clear();
+    state.data.drft.shrink_to_fit();
+    SRV_TRC(" - spilled prompt cache state to disk: %s (%.3f MiB)\n",
+            path.c_str(), state.disk_size() / (1024.0 * 1024.0));
+    return true;
+}
