+void server_prompt_cache::remove_disk_file(server_prompt_cache_state & state) {
+    if (!state.disk_path.empty()) {
+        std::remove(state.disk_path.c_str());
+        state.disk_path.clear();
+        state.disk_size_tgt = 0;
+        state.disk_size_dft = 0;
+    }
+}
