+bool server_prompt_cache::save(const server_prompt & prompt, llama_context * ctx_tgt, llama_context * ctx_dft, int32_t id_slot) {
+    const size_t cur_size_tgt =           llama_state_seq_get_size_ext(ctx_tgt, id_slot, LLAMA_STATE_SEQ_FLAGS_NONE);
+    const size_t cur_size_dft = ctx_dft ? llama_state_seq_get_size_ext(ctx_dft, id_slot, LLAMA_STATE_SEQ_FLAGS_NONE) : 0;
+    const size_t cur_size     = cur_size_tgt + cur_size_dft;
+
+    SRV_TRC(" - saving prompt with length %d, total state size = %.3f MiB (draft: %.3f MiB)\n",
+            (int) prompt.tokens.size(), cur_size / (1024.0 * 1024.0), cur_size_dft / (1024.0 * 1024.0));
+
+    if (!ram_disabled) {
+        if (auto * cur = alloc(prompt, cur_size_tgt, cur_size_dft)) {
+            llama_state_seq_get_data_ext(ctx_tgt, cur->data.main.data(), cur_size_tgt, id_slot, LLAMA_STATE_SEQ_FLAGS_NONE);
+            if (ctx_dft) {
+                llama_state_seq_get_data_ext(ctx_dft, cur->data.drft.data(), cur_size_dft, id_slot, LLAMA_STATE_SEQ_FLAGS_NONE);
+            }
+            return true;
+        }
+    }
+
+    if (disk_disabled || (limit_disk_size > 0 && cur_size > limit_disk_size)) {
+        return false;
+    }
+
+    for (auto it = states.begin(); it != states.end(); ++it) {
+        const int cur_lcp_len = it->prompt.tokens.get_common_prefix(prompt.tokens);
+        if (cur_lcp_len == (int) prompt.tokens.size()) {
+            SRV_TRC("%s", " - prompt is already in the cache, skipping\n");
+            return false;
+        }
+    }
+
+    for (auto it = states.begin(); it != states.end();) {
+        const int len = it->prompt.tokens.get_common_prefix(prompt.tokens);
+        if (len == (int) it->prompt.tokens.size()) {
+            remove_disk_file(*it);
+            it = states.erase(it);
+        } else {
+            ++it;
+        }
+    }
+
+    evict_disk_for(cur_size);
+
+    std::vector<uint8_t> tmp_tgt;
+    std::vector<uint8_t> tmp_dft;
+    try {
+        tmp_tgt.resize(cur_size_tgt);
+        tmp_dft.resize(cur_size_dft);
+    } catch (const std::bad_alloc & e) {
+        SRV_WRN("failed to allocate transient buffer for disk prompt cache: %s\n", e.what());
+        return false;
+    }
+
+    llama_state_seq_get_data_ext(ctx_tgt, tmp_tgt.data(), cur_size_tgt, id_slot, LLAMA_STATE_SEQ_FLAGS_NONE);
+    if (ctx_dft) {
+        llama_state_seq_get_data_ext(ctx_dft, tmp_dft.data(), cur_size_dft, id_slot, LLAMA_STATE_SEQ_FLAGS_NONE);
+    }
+
+    const std::string path = (std::filesystem::path(disk_dir) / ("ps5lm_ckpt_" + std::to_string(next_disk_id++) + ".bin")).string();
+    const bool wrote = write_disk_blob(path, tmp_tgt.data(), tmp_tgt.size(), tmp_dft.data(), tmp_dft.size());
+    tmp_tgt.clear();
+    tmp_tgt.shrink_to_fit();
+    tmp_dft.clear();
+    tmp_dft.shrink_to_fit();
+
+    if (!wrote) {
+        SRV_WRN("failed to write disk prompt cache state to %s\n", path.c_str());
+        return false;
+    }
+
+    states.push_back({
+        /*.prompt =*/ {
+            /*.tokens      =*/ prompt.tokens.clone(),
+            /*.checkpoints =*/ prompt.checkpoints,
+        },
+        /*.data   =*/ {},
+        /*.disk_path     =*/ path,
+        /*.disk_size_tgt =*/ cur_size_tgt,
+        /*.disk_size_dft =*/ cur_size_dft,
+    });
+    SRV_TRC(" - saved prompt cache directly to disk: %s (%.3f MiB)\n", path.c_str(), cur_size / (1024.0 * 1024.0));
+    return true;
+}
